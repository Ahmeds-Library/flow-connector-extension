{
  "manifest_version": 3,
  "name": "Flow Connector — AI Agent Filmmaker for Google Flow",
  "short_name": "Flow Connector",
  "version": "1.1.0",
  "author": "Mirza Ahmed Hassan",
  "description": "Drive Google Flow from AI agents (Antigravity, Claude, Cursor) through your logged-in browser session. Developed by Mirza Ahmed Hassan. Zero API fees.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-BhsddTr5.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Flow Connector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "resources": [
        "capture.js",
        "assets/remote-selectors-DMGoT9dd.js",
        "assets/links-DTGQK3hI.js",
        "assets/index.ts-C7KKKMfj.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
