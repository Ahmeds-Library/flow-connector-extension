# ==============================================================================
# Flow Connector Extension — .gitignore
# ==============================================================================

# --- Generated Media & Exports ---
# Google Flow downloaded images, videos, and incomplete downloads (270MB+ media files)
exports/
*.crdownload

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editor & IDE Files ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Secrets & Environment Configurations ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Logs & Runtime Temp Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Dependency Folders (if npm/node is used in root) ---
node_modules/
.npm
.cache/

# NOTE: Do NOT add 'dist/' or 'assets/' or '*.js' here!
# The 'extension/' directory contains the ready-to-use unpacked Chrome Extension
# runtime files (manifest.json, assets/, src/, icons/) which are essential
# for any user cloning this repo to immediately load and use the extension.
